# Application
AGPP_ENV=development

# Database
POSTGRES_USER=your_db_username
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=change-me

# Inventory stock feed (config/pipelines/inventory.yaml)
INVENTORY_API_URL=http://feed:8080
INVENTORY_API_TOKEN=

# Airflow (orchestration/airflow), local use only
AGPP_DATA_DIR=/absolute/host/path/to/agpp-data-platform/data
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_JWT_SECRET=local-dev-only-change-me-0123456789abcdef
